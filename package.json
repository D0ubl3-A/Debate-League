{
  "name": "stride-enterprise-platform",
  "version": "3.0.0",
  "description": "Stride Enterprise Platform v3.0 - Complete AI-Powered Collaboration Ecosystem",
  "main": "core-platform.js",
  "scripts": {
    "start": "node core-platform.js",
    "dev": "nodemon core-platform.js",
    "build": "npm run build:production",
    "build:production": "webpack --mode=production",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "deploy": "vercel --prod",
    "docker:build": "docker build -t stride-enterprise:v3.0.0 .",
    "docker:run": "docker run -p 8080:8080 stride-enterprise:v3.0.0",
    "k8s:deploy": "kubectl apply -f k8s/",
    "monitoring:start": "docker-compose -f monitoring/docker-compose.yml up -d"
  },
  "keywords": [
    "enterprise",
    "collaboration",
    "ai-powered",
    "debate-platform",
    "microservices",
    "kubernetes",
    "real-time",
    "analytics",
    "security",
    "compliance"
  ],
  "author": "Stride Enterprise Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stride-platform/enterprise-v3.git"
  },
  "bugs": {
    "url": "https://github.com/stride-platform/enterprise-v3/issues"
  },
  "homepage": "https://stride-enterprise.vercel.app",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.4",
    "redis": "^4.6.10",
    "pg": "^8.11.3",
    "mongoose": "^8.0.3",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "rate-limiter-flexible": "^3.0.8",
    "winston": "^3.11.0",
    "prometheus-client": "^15.0.0",
    "groq-sdk": "^0.7.0",
    "openai": "^4.20.1",
    "anthropic": "^0.9.1",
    "tensorflow": "^4.15.0",
    "kubernetes-client": "^10.0.0",
    "aws-sdk": "^2.1498.0",
    "stripe": "^14.9.0",
    "nodemailer": "^6.9.7",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.6",
    "ffmpeg": "^0.0.4",
    "ws": "^8.14.2",
    "compression": "^1.7.4",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "docker": "^1.0.0",
    "@types/node": "^20.10.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}